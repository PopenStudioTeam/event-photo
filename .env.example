# =============================================================================
# Event Photo Sharing — environment variables
# Copy to apps/api/.env and apps/web/.env.local (or your deployment provider).
# =============================================================================

# --- Shared (API) — required ---

# PostgreSQL connection string (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret for JWT auth tokens (organizer login + gallery unlock tokens)
JWT_SECRET=change-me-to-a-long-random-string

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- API (apps/api) ---

# Allowed browser origin for CORS (your web app URL in production)
CORS_ORIGIN=https://127.0.0.1:3000,https://localhost:3000

# Public web app URL — used for QR codes and Whop redirect URLs when origin is unknown
BASE_WEB_URL=https://127.0.0.1:3000
WEB_APP_URL=https://127.0.0.1:3000

# Google Sign-In (optional — email/password works without this)
GOOGLE_CLIENT_ID=

# Whop (optional — free events work without payment)
WHOP_API_KEY=
WHOP_SANDBOX=true
WHOP_WEBHOOK_SECRET=
WHOP_ACCOUNT_ID=
WHOP_PREMIUM_PLAN_ID=
WHOP_PRO_PLAN_ID=

# Optional. If set, organizers can skip Whop by sending this key in checkout.
# Keep this secret — do not prefix with NEXT_PUBLIC_. Leave empty to disable.
PAYMENT_BYPASS_KEY=

# --- Web (apps/web) — prefix with NEXT_PUBLIC_ for client-side access ---

NEXT_PUBLIC_API_URL=https://127.0.0.1:4000
NEXT_PUBLIC_BASE_WEB_URL=https://127.0.0.1:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
