# =============================================================================
# Event Photo Sharing — environment variables
# Copy to apps/api/.env and apps/web/.env.local (or your deployment provider).
# =============================================================================

# --- Shared (API) — required ---

# PostgreSQL connection string (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret for JWT auth tokens (organizer login + gallery unlock tokens)
JWT_SECRET=change-me-to-a-long-random-string

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- API (apps/api) ---

# Allowed browser origin for CORS (your web app URL in production)
CORS_ORIGIN=http://localhost:3000

# Public web app URL — used for QR codes and Stripe redirect URLs when origin is unknown
BASE_WEB_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Google Sign-In (optional — email/password works without this)
GOOGLE_CLIENT_ID=

# Stripe (optional — free events work without payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# --- Web (apps/web) — prefix with NEXT_PUBLIC_ for client-side access ---

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BASE_WEB_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
